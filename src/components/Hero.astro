											<div class="tx-info">
												<p class="tx-name">Compra en RA...</p>
												<p class="tx-date">Oct 01, 2025</p>
											</div>
											<p class="tx-amount">$171,700.00</p>
										</div>
										<div class="transaction">
											<div class="tx-icon-wrapper">
												<span class="tx-emoji">💳</span>
											</div>
											<div class="tx-info">
												<p class="tx-name">MEDIUM ANN...</p>
												<p class="tx-date">Oct 01, 2025</p>
											</div>
											<p class="tx-amount">$198,139.00</p>
										</div>
										<div class="transaction">
											<div class="tx-icon-wrapper">
												<span class="tx-emoji">💳</span>
											</div>
											<div class="tx-info">
												<p class="tx-name">Amazon Web Ser...</p>
												<p class="tx-date">Oct 01, 2025</p>
											</div>
											<p class="tx-amount">$2,081.00</p>
										</div>
									</div>
								</div>
								<div class="fab-button">
									<span>+</span>
								</div>
								<div class="bottom-nav">
									<div class="nav-item active">
										<svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
											<path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/>
										</svg>
									</div>
									<div class="nav-item">
										<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
											<path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
											<circle cx="12" cy="7" r="4"></circle>
										</svg>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 2rem;
	}

	.hero {
		min-height: 100vh;
		display: flex;
		align-items: center;
		padding-top: 100px;
		padding-bottom: 4rem;
	}

	.hero .container {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 4rem;
		align-items: center;
	}

	.hero-title {
		font-size: 3.5rem;
		font-weight: 700;
		line-height: 1.1;
		margin-bottom: 1.5rem;
		letter-spacing: -0.02em;
	}

	.accent {
		color: var(--color-accent);
	}

	.hero-subtitle {
		font-size: 1.125rem;
		color: var(--color-gray);
		margin-bottom: 2.5rem;
		line-height: 1.7;
		max-width: 500px;
	}

	.cta-buttons {
		display: flex;
		gap: 1rem;
		align-items: center;
	}

	.cta-button {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 1rem 2rem;
		border-radius: 12px;
		font-weight: 600;
		font-size: 1rem;
		cursor: pointer;
		transition: all 0.3s ease;
		text-decoration: none;
		border: none;
	}

	.cta-button.primary {
		background: linear-gradient(135deg, var(--color-accent) 0%, var(--color-accent-secondary) 100%);
		color: white;
		box-shadow: 0 4px 20px rgba(var(--color-accent-rgb), 0.3);
	}

	.cta-button.primary:hover {
		transform: translateY(-2px);
		box-shadow: 0 6px 30px rgba(var(--color-accent-rgb), 0.4);
	}

	/* Phone Mockup */
	.hero-image {
		display: flex;
		justify-content: center;
		align-items: center;
	}

	.phone-mockup {
		position: relative;
		width: 340px;
		height: 700px;
	}

	.phone-frame {
		width: 100%;
		height: 100%;
		background: linear-gradient(145deg, #1f2937, #111827);
		border-radius: 48px;
		padding: 12px;
		box-shadow: 
			0 0 0 12px #0f172a,
			0 30px 60px rgba(0, 0, 0, 0.5),
			inset 0 0 2px rgba(255, 255, 255, 0.1);
		position: relative;
	}

	.phone-frame::before {
		content: '';
		position: absolute;
		top: 20px;
		left: 50%;
		transform: translateX(-50%);
		width: 120px;
		height: 30px;
		background: #0f172a;
		border-radius: 0 0 20px 20px;
		z-index: 2;
	}

	.phone-screen {
		width: 100%;
		height: 100%;
		background: #2b3a56;
		border-radius: 38px;
		overflow: hidden;
		position: relative;
	}

	/* App Preview */
	.app-preview {
		padding: 1.25rem;
		padding-top: 1rem;
		height: 100%;
		display: flex;
		flex-direction: column;
		position: relative;
	}

	.app-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 1.25rem;
		font-size: 0.9375rem;
		color: white;
		font-weight: 600;
	}

	.time {
		font-weight: 600;
	}

	.status-icons {
		display: flex;
		gap: 0.375rem;
		align-items: center;
	}

	.status-icon {
		font-size: 0.75rem;
		filter: grayscale(1) brightness(1.5);
	}

	.app-content {
		flex: 1;
		display: flex;
		flex-direction: column;
		gap: 0.875rem;
		padding-bottom: 4rem;
	}

	.balance-card {
		background: #3d4f6d;
		border-radius: 18px;
		padding: 1.5rem;
		text-align: center;
	}

	.balance-label {
		font-size: 0.9375rem;
		color: rgba(255, 255, 255, 0.8);
		margin-bottom: 0.625rem;
		font-weight: 500;
	}

	.balance-amount {
		font-size: 2.25rem;
		font-weight: 700;
		color: white;
		margin-bottom: 0;
		letter-spacing: -0.02em;
	}

	.quick-stats {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0.75rem;
	}

	.stat {
		background: #354358;
		border-radius: 14px;
		padding: 1rem;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.5rem;
	}

	.stat-icon-wrapper {
		width: 100%;
		display: flex;
		justify-content: flex-start;
	}

	.stat-emoji {
		font-size: 1.625rem;
	}

	.stat-info {
		width: 100%;
	}

	.stat-label {
		font-size: 0.75rem;
		color: rgba(255, 255, 255, 0.65);
		margin-bottom: 0.375rem;
		font-weight: 400;
	}

	.stat-value {
		font-size: 1.0625rem;
		font-weight: 600;
		color: white;
		letter-spacing: -0.01em;
	}

	.recent-transactions {
		flex: 1;
		display: flex;
		flex-direction: column;
	}

	.recent-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 0.875rem;
	}

	.recent-transactions h3 {
		font-size: 1.0625rem;
		font-weight: 600;
		color: white;
	}

	.see-all {
		font-size: 0.8125rem;
		color: #6b7bf8;
		text-decoration: none;
		font-weight: 500;
	}

	.tx-list {
		display: flex;
		flex-direction: column;
		gap: 0.625rem;
	}

	.transaction {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.875rem;
		background: #354358;
		border-radius: 12px;
	}

	.tx-icon-wrapper {
		width: 42px;
		height: 42px;
		display: flex;
		align-items: center;
		justify-content: center;
		background: rgba(107, 123, 248, 0.15);
		border-radius: 10px;
		flex-shrink: 0;
	}

	.tx-emoji {
		font-size: 1.375rem;
	}

	.tx-info {
		flex: 1;
		min-width: 0;
	}

	.tx-name {
		font-size: 0.875rem;
		font-weight: 500;
		color: white;
		margin-bottom: 0.25rem;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.tx-date {
		font-size: 0.75rem;
		color: rgba(255, 255, 255, 0.5);
	}

	.tx-amount {
		font-size: 0.9375rem;
		font-weight: 600;
		color: #ff5757;
		flex-shrink: 0;
	}

	.fab-button {
		position: absolute;
		bottom: 4.5rem;
		right: 50%;
		transform: translateX(50%);
		width: 58px;
		height: 58px;
		background: linear-gradient(135deg, #6b7bf8 0%, #8b5cf6 100%);
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		box-shadow: 0 8px 24px rgba(107, 123, 248, 0.5);
		z-index: 10;
	}

	.fab-button span {
		font-size: 2rem;
		color: white;
		font-weight: 300;
		line-height: 1;
	}

	.bottom-nav {
		position: absolute;
		bottom: 1.25rem;
		left: 1.5rem;
		right: 1.5rem;
		display: flex;
		justify-content: space-around;
		align-items: center;
		gap: 1rem;
	}

	.nav-item {
		flex: 1;
		display: flex;
		justify-content: center;
		align-items: center;
		color: rgba(148, 163, 184, 0.5);
	}

	.nav-item.active {
		color: #6b7bf8;
	}

	.nav-item svg {
		width: 26px;
		height: 26px;
	}

	@media (max-width: 968px) {
		.hero {
			padding-top: 120px;
		}

		.hero .container {
			grid-template-columns: 1fr;
			gap: 3rem;
		}

		.hero-image {
			order: -1;
		}

		.phone-mockup {
			width: 300px;
			height: 620px;
		}

		.hero-title {
			font-size: 2.5rem;
		}

		.hero-subtitle {
			font-size: 1rem;
		}

		.cta-buttons {
			flex-direction: column;
			width: 100%;
		}

		.cta-button {
			width: 100%;
			justify-content: center;
		}
	}
</style>
